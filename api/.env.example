NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Base du docker-compose.yml à la racine (port 5434)
DATABASE_URL=postgresql://tononkira:tononkira@localhost:5434/tononkira?schema=public
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Jeton de l'administration (/admin), au moins 24 caractères. Sans lui, /api/admin est désactivé.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
# Facultatif : chemins vers la brique data/ (valeurs par défaut : ../data, son .venv et output/)
# DATA_DIR=
# PYTHON_BIN=
# CRAWL_STATE_PATH=
# EXPORT_PATH=
